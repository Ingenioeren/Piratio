# Pirat.io production server configuration
NODE_ENV=production
PORT=8080

# PostgreSQL + session security
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/piratio
PGSSL=require
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Google Play Games OAuth
GOOGLE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-web-oauth-client-secret
GOOGLE_PLAY_GAMES_APP_ID=your-play-games-app-id
GOOGLE_REDIRECT_URI=

# Google service account with Play Integrity + Android Publisher access.
# Store the complete JSON as a secret. Never commit the real value.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
ANDROID_PACKAGE_NAME=com.gillingteknik.piratio
REQUIRE_PLAY_INTEGRITY=true

# Apple Game Center identity verification for the future iOS client
APPLE_BUNDLE_ID=com.gillingteknik.piratio
